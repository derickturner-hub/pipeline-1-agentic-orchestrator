# ==============================================================================
# REVOPS AGENTIC PIPELINE - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# System Orchestration Mode (DEVELOPMENT | STAGING | PRODUCTION)
PIPELINE_ENV=PRODUCTION

# LLM Intelligence Providers
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Downstream Target Adapter (Options: CLICKUP | JIRA | HUBSPOT | WEBFLOW_CMS | MULTI_CHANNEL)
PRIMARY_STAGING_ADAPTER=MULTI_CHANNEL

# ClickUp Adapter Settings
CLICKUP_API_TOKEN=pk_...
CLICKUP_LIST_ID=123456789

# Jira Adapter Settings (Optional)
JIRA_HOST=https://your-domain.atlassian.net
JIRA_API_TOKEN=...
JIRA_PROJECT_KEY=REVOPS

# Webflow CMS Adapter Settings (Optional)
WEBFLOW_API_TOKEN=...
WEBFLOW_COLLECTION_ID=...
