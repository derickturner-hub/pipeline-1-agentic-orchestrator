{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContentIntelligenceContract",
  "type": "object",
  "required": [
    "meta_title",
    "meta_description",
    "slug",
    "aio_quick_answer",
    "html_body",
    "schema_json_ld",
    "distribution_hooks"
  ],
  "properties": {
    "meta_title": { "type": "string", "maxLength": 70 },
    "meta_description": { "type": "string", "maxLength": 170 },
    "slug": { "type": "string" },
    "aio_quick_answer": { "type": "string" },
    "html_body": { "type": "string" },
    "schema_json_ld": { "type": "object" },
    "distribution_hooks": {
      "type": "object",
      "required": ["social_summary", "crm_stage_notes"],
      "properties": {
        "social_summary": { "type": "string" },
        "crm_stage_notes": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
