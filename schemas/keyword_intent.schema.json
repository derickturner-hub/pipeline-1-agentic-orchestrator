{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KeywordIntentContract",
  "type": "object",
  "required": [
    "raw_keyword",
    "normalized_keyword",
    "target_vertical",
    "search_intent",
    "is_local_intent",
    "geo_target"
  ],
  "properties": {
    "raw_keyword": { "type": "string" },
    "normalized_keyword": { "type": "string" },
    "target_vertical": { "type": "string" },
    "search_intent": {
      "type": "string",
      "enum": ["INFORMATIONAL", "COMMERCIAL_INVESTIGATION", "TRANSACTIONAL", "NAVIGATIONAL"]
    },
    "is_local_intent": { "type": "boolean" },
    "geo_target": { "type": "string" }
  },
  "additionalProperties": false
}
